{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "outDir": "./les_articles/article3/dist",
        "rootDir": "./les_articles/article3/ts",
        "declaration": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": false,
        "verbatimModuleSyntax": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"]
    },
    "include": ["les_articles/article3/ts/**/*"],
    "exclude": ["node_modules", "les_articles/article3/dist"]
}